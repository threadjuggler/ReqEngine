# Example environment variables for local development WITHOUT Docker.
# Copy to .env and adjust as needed.
# The docker-compose.yml stack defines its own values directly — this file is
# informational for running backend and frontend directly on the host.

DATABASE_URL=postgresql+asyncpg://appuser:apppassword@localhost:5432/reqengine
REDIS_URL=redis://localhost:6379/0
UVICORN_WORKERS=4
CORS_ORIGINS=http://localhost:5173
