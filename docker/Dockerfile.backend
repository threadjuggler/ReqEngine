# Builds the ReqEngine backend image using uv for dependency management.
# Build context: ./backend (set in docker-compose.yml); dockerfile path: ./docker/Dockerfile.backend.
FROM python:3.12-slim

# Install uv via the official distroless image layer
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency manifests first for layer caching
COPY pyproject.toml uv.lock ./

# Sync all non-dev deps without reinstalling if lock unchanged
RUN uv sync --frozen --no-dev

# Copy application source
COPY . .

# Write and make executable the entrypoint script inline (build context is ./backend,
# so ../docker/ is not accessible via COPY)
RUN printf '%s\n' \
    '#!/usr/bin/env sh' \
    '# Runs Alembic migrations then starts the uvicorn server.' \
    'set -e' \
    'echo "Running alembic upgrade..."' \
    'uv run alembic upgrade head' \
    'echo "Starting uvicorn (${UVICORN_WORKERS:-4} workers)..."' \
    'exec uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers "${UVICORN_WORKERS:-4}"' \
    > /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
